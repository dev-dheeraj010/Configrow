NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: search engine ownership tokens (see SEO.md)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare Turnstile (public site key; the secret goes to Supabase: npx supabase secrets set TURNSTILE_SECRET_KEY=...)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
